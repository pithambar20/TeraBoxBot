# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# TeraBox Account Cookie (NDUS token from browser DevTools)
# Example: ndus=Yxxxxxx... or just the raw token string
TERABOX_COOKIE=your_terabox_ndus_cookie_here

# Optional: Download directory (relative or absolute path)
DOWNLOAD_DIR=downloads

# Optional: Network request timeout in seconds
NETWORK_TIMEOUT=60
